# FixRoute Environment Configuration Example
# Copy this file to .env and customize values as appropriate.

# Application Settings
APP_NAME=FixRoute
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings
# Local SQLite default:
DATABASE_URL=sqlite:///./fixroute.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://fixroute_user:password@localhost:5432/fixroute_db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# AI Provider Settings (Optional - Full offline rule-based search engine works without API keys)
AI_PROVIDER=none
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here

# Initial Admin Credentials (Provisioned on first seed)
ADMIN_EMAIL=admin@fixroute.in
ADMIN_PASSWORD=AdminSecureFixRoute2026!
